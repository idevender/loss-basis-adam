# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/

# Environments
.venv/
venv/
env/

# OS / editors
.DS_Store
.vscode/
.idea/

# Data (see README for where to obtain the public datasets). Both spellings: the
# bare name also catches the case where data is a symlink to an external root,
# which "data/" does not match.
data/
data
*.mat
*.npy
*.npz
*.pkl
*.pth
*.pt

# Experiment logs and results
*.out
*.jsonl
results/
runs/
logs/*
!logs/attention_gauge_cpu.txt
!logs/attention_gauge_noise_cpu.txt
wandb/

# Tooling caches
.pytest_cache/

# Figure outputs (regenerate with figures/make_figures.py)
figures/*.pdf
figures/*.png

# Raw H100/Nibi cluster records behind Tables 5, 9 and 11. Committed on purpose:
# they are the only copy of those runs, and they let a reader check those tables
# without a GPU allocation. (Overrides the *.jsonl rule above.)
!experiments/nibi_results/*.jsonl
!experiments/nibi_results/*.md
